# =============================================================================
# TeleMed Seva — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Flask ---
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string

# --- Database ---
# SQLite (development)
DATABASE_URL=sqlite:///telemed_seva.db
# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/telemed_seva

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Mail ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@telemedseva.com

# --- File Uploads ---
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# --- Payment Provider ---
# Razorpay (leave empty to use mock provider)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Stripe
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Security ---
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# --- Platform Settings ---
PLATFORM_NAME=TeleMed Seva
PLATFORM_CURRENCY=INR
PLATFORM_CURRENCY_SYMBOL=₹
DEFAULT_CONSULTATION_DURATION=30
